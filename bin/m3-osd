#!/usr/bin/env bash
# m3-osd - change volume / brightness and show the Material 3 pop-up.
#   m3-osd volume up|down|mute      m3-osd mic mute      m3-osd brightness up|down
osd() { command -v swayosd-client >/dev/null && pgrep -x swayosd-server >/dev/null && swayosd-client "$@" 2>/dev/null; }
case "${1:-} ${2:-}" in
    "volume up")       osd --output-volume raise       || wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+ ;;
    "volume down")     osd --output-volume lower       || wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
    "volume mute")     osd --output-volume mute-toggle || wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
    "mic mute")        osd --input-volume mute-toggle  || wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle ;;
    "brightness up")   osd --brightness raise          || brightnessctl -e4 -n2 set 5%+ ;;
    "brightness down") osd --brightness lower          || brightnessctl -e4 -n2 set 5%- ;;
    *) sed -n '2,3p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
