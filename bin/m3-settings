        # Modules
        r_taskbar = switch("Window taskbar", self.s.get("bar_show_taskbar", True),
                           lambda on: update_bar_setting("bar_show_taskbar", on),
                           subtitle="Show open windows in the top bar")
        r_min_btn = switch("Minimize button", self.s.get("bar_show_minimize", False),
                           lambda on: update_bar_setting("bar_show_minimize", on),
                           subtitle="Show clickable minimize button next to taskbar")
        r_min_pill = switch("Minimized windows pill", self.s.get("bar_show_minimized", True),
                            lambda on: update_bar_setting("bar_show_minimized", on),
                            subtitle="Show pill when windows are minimized")
        r_shot = switch("Screenshot button", self.s.get("bar_show_screenshot", False),
                        lambda on: update_bar_setting("bar_show_screenshot", on),
                        subtitle="Show screenshot icon in the top bar")
        r_tray = switch("System tray", self.s.get("bar_show_tray", True),
                        lambda on: update_bar_setting("bar_show_tray", on),
                        subtitle="Show background status and notification icons")
        r_net = switch("Network icon", self.s.get("bar_show_network", True),
                       lambda on: update_bar_setting("bar_show_network", on),
                       subtitle="Show Wi-Fi / Ethernet indicator")
        r_aud = switch("Volume icon", self.s.get("bar_show_audio", True),
                       lambda on: update_bar_setting("bar_show_audio", on),
                       subtitle="Show speaker volume indicator")
        r_batt = switch("Battery status", self.s.get("bar_show_battery", True),
                        lambda on: update_bar_setting("bar_show_battery", on),
                        subtitle="Show battery percentage and charging indicator")
        r_notif = switch("Notifications button", self.s.get("bar_show_notifications", True),
                         lambda on: update_bar_setting("bar_show_notifications", on),
                         subtitle="Show notification center toggle")
        r_theme = switch("Appearance button", self.s.get("bar_show_theme", False),
                         lambda on: update_bar_setting("bar_show_theme", on),
                         subtitle="Show theme customize icon on top bar")

        # Actions
        reload_row = Adw.ActionRow(title="Reload top bar", subtitle="Refresh Waybar styling and layout",
                                   activatable=True)
        reload_row.add_suffix(Gtk.Image.new_from_icon_name("view-refresh-symbolic"))
        reload_row.connect("activated", lambda _r: (subprocess.run(["pkill", "-SIGUSR2", "waybar"]),
                                                    self.toast("Top bar reloaded")))

        return self.page(
            self.group("Clock", rows=[r_12h, r_date, r_sec]),
            self.group("Launcher", rows=[r_icon, r_text]),
            self.group("Modules", rows=[r_taskbar, r_min_btn, r_min_pill, r_shot, r_tray, r_net, r_aud, r_batt, r_notif, r_theme]),
            self.group(rows=[reload_row])
        )

    # -- Network -----------------------------------------------------------
    def page_network(self):
        if not have("nmcli") or not run("nmcli", "-t", "general", "status")[0]:
            return status("network-offline-symbolic", "NetworkManager isn't running",
                          "Network settings need NetworkManager. Your connection may be managed by something else.")
        wifi_on = run("nmcli", "radio", "wifi")[1] == "enabled"
        devs = [split_nmcli(x) for x in run("nmcli", "-t", "-f", "DEVICE,TYPE,STATE,CONNECTION", "dev")[1].splitlines()]
        has_wifi = any(len(d) > 1 and d[1] == "wifi" for d in devs)

        wired_rows = []
        for d in devs:
            if len(d) >= 4 and d[1] == "ethernet":
                up = d[2].startswith("connected")
                r = Adw.ActionRow(title=d[3] if up and d[3] else d[0],
                                  subtitle="Connected" if up else d[2].capitalize())
                r.add_prefix(Gtk.Image.new_from_icon_name("network-wired-symbolic"))
                wired_rows.append(r)

        self.wifi_group = self.group("Wi-Fi networks")
        self.wifi_rows = []
        refresh = Gtk.Button(icon_name="view-refresh-symbolic", valign=Gtk.Align.CENTER,
                             tooltip_text="Scan again")
        refresh.add_css_class("flat")
        refresh.connect("clicked", lambda _b: self.wifi_scan(True))
        self.wifi_group.set_header_suffix(refresh)

        def toggle(on):
            run("nmcli", "radio", "wifi", "on" if on else "off")
            GLib.timeout_add(1500, lambda: (self.wifi_scan(False), False)[1])
        groups = []
        if wired_rows:
            groups.append(self.group("Wired", rows=wired_rows))
        if has_wifi:
            groups.append(self.group("Wi-Fi", rows=[switch("Wi-Fi", wifi_on, toggle)]))
            groups.append(self.wifi_group)
            self.wifi_scan(False)
        elif not wired_rows:
            return status("network-offline-symbolic", "No network devices", "No Wi-Fi or wired adapter was found.")
        return self.page(*groups)

    def wifi_scan(self, rescan):
        def done(ok, out):
            for r in self.wifi_rows:
                self.wifi_group.remove(r)
            self.wifi_rows = []
            seen = set()
            for line in out.splitlines() if ok else []:
                f = split_nmcli(line)
                if len(f) < 4 or not f[1] or f[1] in seen:
                    continue
                seen.add(f[1])
                active, ssid, signal, sec = f[0] == "*", f[1], int(f[2] or 0), f[3]
                level = "excellent" if signal > 75 else "good" if signal > 50 else "ok" if signal > 25 else "weak"
                row = Adw.ActionRow(title=GLib.markup_escape_text(ssid), activatable=not active,
                                    subtitle="Connected" if active else ("Secured" if sec and sec != "--" else "Open"))
                row.add_prefix(Gtk.Image.new_from_icon_name("network-wireless-signal-%s-symbolic" % level))
                if active:
                    b = Gtk.Button(label="Disconnect", valign=Gtk.Align.CENTER)
                    b.connect("clicked", lambda _b, s=ssid: async_run(
                        ["nmcli", "connection", "down", "id", s], lambda *_a: self.wifi_scan(False)))
                    row.add_suffix(b)
                else:
                    row.add_suffix(Gtk.Image.new_from_icon_name("go-next-symbolic"))
                    row.connect("activated", lambda _r, s=ssid, secured=(sec and sec != "--"): self.wifi_connect(s, secured))
                self.wifi_group.add(row)
                self.wifi_rows.append(row)
            if not self.wifi_rows:
                row = Adw.ActionRow(title="No networks found" if ok else "Wi-Fi is off")
                self.wifi_group.add(row)
                self.wifi_rows.append(row)
        async_run(["nmcli", "-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY", "dev", "wifi", "list",
                   "--rescan", "yes" if rescan else "auto"], done)

    def wifi_connect(self, ssid, secured, password=None):
        known = any(split_nmcli(x)[0] == ssid for x in
                    run("nmcli", "-t", "-f", "NAME", "connection", "show")[1].splitlines())
        if secured and not known and password is None:
            dlg = Adw.MessageDialog(transient_for=self.win, heading="Connect to " + ssid,
                                    body="Enter the Wi-Fi password.")
            entry = Gtk.PasswordEntry(show_peek_icon=True, activates_default=True)
            dlg.set_extra_child(entry)
            dlg.add_response("cancel", "Cancel")
            dlg.add_response("connect", "Connect")
            dlg.set_response_appearance("connect", Adw.ResponseAppearance.SUGGESTED)
            dlg.set_default_response("connect")
            dlg.connect("response", lambda d, r: r == "connect" and self.wifi_connect(ssid, True, entry.get_text()))
            dlg.present()
            return
        cmd = (["nmcli", "connection", "up", "id", ssid] if known and password is None
               else ["nmcli", "dev", "wifi", "connect", ssid] + (["password", password] if password else []))
        self.toast("Connecting to %s…" % ssid)

        def done(ok, out):
            self.toast("Connected to " + ssid if ok else "Could not connect: " + out.splitlines()[-1][-70:])
            self.wifi_scan(False)
        async_run(cmd, done, timeout=60)

    # -- Bluetooth ---------------------------------------------------------
    def page_bluetooth(self):
        if not have("bluetoothctl"):
            return status("bluetooth-disabled-symbolic", "Bluetooth isn't installed", "Install the bluez package.")
        ok, show = run("bluetoothctl", "show", timeout=5)
        if not ok or "Controller" not in show:
            return status("bluetooth-disabled-symbolic", "No Bluetooth adapter",
                          "This computer has no Bluetooth adapter, or the bluetooth service isn't running.")
        powered = "Powered: yes" in show

        def power(on):
            run("bluetoothctl", "power", "on" if on else "off")
            GLib.timeout_add(800, lambda: (self.rebuild("bluetooth"), False)[1])
        self.bt_group = self.group("Devices")
        scan = Gtk.Button(label="Search", valign=Gtk.Align.CENTER, sensitive=powered)
        scan.add_css_class("flat")

        def do_scan(b):
            b.set_sensitive(False)
            b.set_label("Searching…")
            async_run(["bluetoothctl", "--timeout", "8", "scan", "on"],
                      lambda *_a: self.rebuild("bluetooth"), timeout=20)
        scan.connect("clicked", do_scan)
        self.bt_group.set_header_suffix(scan)

        devices = []
        for line in run("bluetoothctl", "devices")[1].splitlines():
            m = re.match(r"Device (\S+) (.*)", line)
            if m:
                devices.append(m.groups())
        for mac, name in devices if powered else []:
            info = run("bluetoothctl", "info", mac, timeout=5)[1]
            connected, paired = "Connected: yes" in info, "Paired: yes" in info
            if not paired and re.fullmatch(r"[0-9A-F-]{17}", name):
                continue  # nameless devices seen during a scan
            row = Adw.ActionRow(title=GLib.markup_escape_text(name),
                                subtitle="Connected" if connected else "Paired" if paired else "Not paired")
            row.add_prefix(Gtk.Image.new_from_icon_name("bluetooth-active-symbolic"))
            btn = Gtk.Button(label="Disconnect" if connected else "Connect" if paired else "Pair",
                             valign=Gtk.Align.CENTER)
            if not connected:
                btn.add_css_class("suggested-action")

            def act(b, mac=mac, name=name, connected=connected, paired=paired):
                b.set_sensitive(False)
                if connected:
                    cmds = [["bluetoothctl", "disconnect", mac]]
                elif paired:
                    cmds = [["bluetoothctl", "connect", mac]]
                else:
                    cmds = [["bluetoothctl", "pair", mac], ["bluetoothctl", "trust", mac],
                            ["bluetoothctl", "connect", mac]]

                def step(ok=True, out=""):
                    if not ok or not cmds:
                        self.toast(("Done: " if ok else "Failed: ") + name)
                        self.rebuild("bluetooth")
                        return
                    async_run(cmds.pop(0), step, timeout=30)
                step()
            btn.connect("clicked", act)
            row.add_suffix(btn)
            if paired:
                rm = Gtk.Button(icon_name="user-trash-symbolic", valign=Gtk.Align.CENTER, tooltip_text="Forget")
                rm.add_css_class("flat")
                rm.connect("clicked", lambda _b, mac=mac: (run("bluetoothctl", "remove", mac), self.rebuild("bluetooth")))
                row.add_suffix(rm)
            self.bt_group.add(row)
        if not devices or not powered:
            self.bt_group.add(Adw.ActionRow(title="Bluetooth is off" if not powered
                                            else "No devices yet - press Search"))
        return self.page(self.group("Bluetooth", rows=[switch("Bluetooth", powered, power)]), self.bt_group)

    # -- Sound -------------------------------------------------------------
    def page_sound(self):
        if not have("pactl") or not run("pactl", "info", timeout=5)[0]:
            return status("audio-volume-muted-symbolic", "No sound server",
                          "PipeWire isn't running, or the pulseaudio-utils package is missing.")
        groups = []
        for kind, title, label in (("sink", "Output", "Speaker or headphones"),
                                   ("source", "Input", "Microphone")):
            try:
                items = json.loads(run("pactl", "-f", "json", "list", kind + "s")[1])
            except ValueError:
                items = []
            items = [x for x in items if not x.get("name", "").endswith(".monitor")]
            if not items:
                groups.append(self.group(title, rows=[Adw.ActionRow(title="No %s device" % title.lower())]))
                continue
            default = run("pactl", "get-default-" + kind)[1]
            names = [x["name"] for x in items]
            cur = items[names.index(default)] if default in names else items[0]
            vols = [int(v.get("value_percent", "0%").rstrip("%")) for v in cur.get("volume", {}).values()] or [0]
            target = "@DEFAULT_%s@" % kind.upper()
            rows = [
                combo(label, [x.get("description", x["name"]) for x in items],
                      names.index(cur["name"]),
                      lambda i, kind=kind, names=names: (run("pactl", "set-default-" + kind, names[i]),
                                                         self.rebuild("sound"))),
                slider("Volume", 0, 100, 1, min(100, vols[0]),
                       lambda v, kind=kind, target=target: run("pactl", "set-%s-volume" % kind, target, "%d%%" % v)),
                switch("Mute", bool(cur.get("mute")),
                       lambda on, kind=kind, target=target: run("pactl", "set-%s-mute" % kind, target, "1" if on else "0")),
            ]
            groups.append(self.group(title, rows=rows))
        return self.page(*groups)

    # -- Keyboard & mouse --------------------------------------------------
    def page_input(self):
        layouts = []
        try:
            section = None
            for line in open("/usr/share/X11/xkb/rules/evdev.lst", encoding="utf-8", errors="replace"):
                if line.startswith("!"):
                    section = line[1:].strip()
                elif section == "layout" and line.strip():
                    code, name = line.split(None, 1)
                    layouts.append((code, name.strip()))
        except OSError:
            pass
        layouts = sorted(layouts, key=lambda x: x[1]) or [("us", "English (US)"), ("gb", "English (UK)")]
        codes = [x[0] for x in layouts]
        cur = self.s["kb_layout"].split(",")[0]
        kb = combo("Keyboard layout", ["%s  (%s)" % (n, c) for c, n in layouts],
                   codes.index(cur) if cur in codes else 0,
                   lambda i: self.set_value("kb_layout", codes[i]), search=True)
        return self.page(
            self.group("Keyboard", rows=[kb]),
            self.group("Mouse", rows=[
                slider("Pointer speed", -1, 1, 0.05, self.s["mouse_sensitivity"],
                       lambda v: self.set_value("mouse_sensitivity", round(v, 2)), digits=2),
                switch("Mouse acceleration", self.s["mouse_accel"], lambda on: self.set_value("mouse_accel", on),
                       subtitle="Off moves the pointer exactly as far as your hand"),
                switch("Natural scrolling", self.s["mouse_natural"], lambda on: self.set_value("mouse_natural", on),
                       subtitle="Content follows the wheel, like on a phone"),
                switch("Left-handed", self.s["left_handed"], lambda on: self.set_value("left_handed", on),
                       subtitle="Swap the left and right buttons"),
            ]),
            self.group("Touchpad", rows=[
                switch("Natural scrolling", self.s["touchpad_natural"], lambda on: self.set_value("touchpad_natural", on)),
                switch("Tap to click", self.s["tap_to_click"], lambda on: self.set_value("tap_to_click", on)),
            ]))

    # -- Lock screen -------------------------------------------------------
    def page_lock(self):
        secs = [t[0] for t in TIMES]
        labels = [t[1] for t in TIMES]

        def idx(v):
            return secs.index(v) if v in secs else 3
        lock_now = Adw.ActionRow(title="Lock now", subtitle="Super+L", activatable=True)
        lock_now.add_suffix(Gtk.Image.new_from_icon_name("go-next-symbolic"))
        lock_now.connect("activated", lambda _r: subprocess.Popen(["hyprlock"], start_new_session=True))

        keys_row = Adw.ActionRow(title="Passwords &amp; Keys",
                                 subtitle="Manage saved passwords, keyrings and SSH keys (Seahorse)",
                                 activatable=True)
        keys_row.add_prefix(Gtk.Image.new_from_icon_name("dialog-password-symbolic"))
        keys_row.add_suffix(Gtk.Image.new_from_icon_name("go-next-symbolic"))
        keys_row.connect("activated", lambda _r: subprocess.Popen(["seahorse"], start_new_session=True))

        return self.page(
            self.group("When idle", rows=[
                combo("Lock the screen after", labels, idx(self.s["lock_after"]),
                      lambda i: self.set_value("lock_after", secs[i], reload=False, idle=True)),
                combo("Turn the screen off after", labels, idx(self.s["screen_off_after"]),
                      lambda i: self.set_value("screen_off_after", secs[i], reload=False, idle=True)),
            ]),
            self.group("Security", rows=[keys_row]),
            self.group(rows=[lock_now])
        )

    # -- Default apps ------------------------------------------------------
    def page_apps(self):
        rows = []
        for title, mimes in APP_KINDS:
            apps = Gio.AppInfo.get_all_for_type(mimes[0])
            if not apps:
                r = Adw.ActionRow(title=title, subtitle="No app installed for this")
                r.set_sensitive(False)
                rows.append(r)
                continue
            default = Gio.AppInfo.get_default_for_type(mimes[0], False)
            ids = [a.get_id() for a in apps]
            sel = ids.index(default.get_id()) if default and default.get_id() in ids else 0

            def choose(i, apps=apps, mimes=mimes):
                for m in mimes:
                    try:
                        apps[i].set_as_default_for_type(m)
                    except GLib.Error:
                        pass
            rows.append(combo(title, [a.get_display_name() for a in apps], sel, choose))
        return self.page(self.group("Open with", "The app used when you open each kind of thing.", rows))

    # -- About -------------------------------------------------------------
    def page_about(self):
        def read(path):
            try:
                return open(path).read()
            except OSError:
                return ""
        osr = dict(re.findall(r'^(\w+)="?([^"\n]*)"?$', read("/etc/os-release"), re.M))
        cpu = re.search(r"model name\s*:\s*(.+)", read("/proc/cpuinfo"))
        mem = re.search(r"MemTotal:\s*(\d+)", read("/proc/meminfo"))
        hypr = run("hyprctl", "version")[1].splitlines()
        ver = re.search(r"Tag: (v[\d.]+)", "\n".join(hypr)) or re.search(r"Hyprland ([\d.]+)", "\n".join(hypr))
        hero = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        hero.add_css_class("m3-hero")
        t = Gtk.Label(label="Material 3 Hyprland", xalign=0)
        t.add_css_class("title-1")
        hero.append(t)
        hero.append(Gtk.Label(label="A Material You desktop with Windows shortcuts", xalign=0))
        hero_group = Adw.PreferencesGroup()
        hero_group.add(hero)
        return self.page(hero_group, self.group("This computer", rows=[
            info_row("Computer name", os.uname().nodename),
            info_row("Operating system", osr.get("PRETTY_NAME")),
            info_row("Hyprland", ver.group(1) if ver else None),
            info_row("Kernel", os.uname().release),
            info_row("Processor", cpu.group(1) if cpu else None),
            info_row("Memory", "%.1f GB" % (int(mem.group(1)) / 1048576) if mem else None),
        ]))


if __name__ == "__main__":
    page_arg = next((a for a in sys.argv[1:] if not a.startswith("-")), "appearance")
    sys.exit(Settings(page_arg).run([sys.argv[0]]))
