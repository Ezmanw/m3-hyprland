#!/usr/bin/env python3
"""m3-settings - the settings app of the Material 3 Hyprland desktop.

    m3-settings            open the app (Super+I)
    m3-settings PAGE       open on a page: appearance, display, network, bluetooth,
                           sound, input, lock, apps, about
    m3-settings --apply    regenerate ~/.config/hypr/settings.lua and hypridle.conf
                           from ~/.config/m3-settings.json (no window)
    m3-settings --night-light [on|off|toggle|status]
"""
import json
import os
import re
import shutil
import subprocess
import sys
import threading

HOME = os.path.expanduser("~")
CFG = os.environ.get("XDG_CONFIG_HOME", HOME + "/.config")
CONF = CFG + "/m3-settings.json"
BIN = HOME + "/.local/bin/"
os.environ["PATH"] = HOME + "/.local/bin:" + os.environ.get("PATH", "/usr/bin:/bin")

DEFAULTS = {
    "kb_layout": "us", "kb_variant": "",
    "mouse_sensitivity": 0.0, "mouse_accel": False, "mouse_natural": False, "left_handed": False,
    "touchpad_natural": True, "tap_to_click": True,
    "monitors": {},
    "night_light": False, "night_temp": 4500,
    "lock_after": 600, "screen_off_after": 900,
    "rounding": 20, "gaps": 8, "border": 2, "animations": True,
    "bar_12h": True, "bar_show_date": True, "bar_show_seconds": False,
    "bar_launcher_icon": "", "bar_launcher_text": True,
    "bar_show_taskbar": True, "bar_show_minimize": False, "bar_show_minimized": True,
    "bar_show_screenshot": False, "bar_show_tray": True, "bar_show_network": True,
    "bar_show_audio": True, "bar_show_battery": True, "bar_show_notifications": True,
    "bar_show_theme": False,
}


# ----------------------------------------------------------------- backend --
def load():
    s = dict(DEFAULTS)
    try:
        with open(CONF) as f:
            s.update(json.load(f))
    except (OSError, ValueError):
        pass
    return s


def save(s):
    os.makedirs(CFG, exist_ok=True)
    with open(CONF + ".tmp", "w") as f:
        json.dump(s, f, indent=2)
    os.replace(CONF + ".tmp", CONF)


def run(*cmd, timeout=15):
    """Run a command, return (ok, stdout)."""
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return p.returncode == 0, (p.stdout if p.returncode == 0 else p.stdout + p.stderr).strip()
    except (OSError, subprocess.TimeoutExpired) as e:
        return False, str(e)


def have(prog):
    return shutil.which(prog) is not None


def lua_str(v):
    return '"' + str(v).replace("\\", "\\\\").replace('"', '\\"') + '"'


def lua_bool(v):
    return "true" if v else "false"


def generate(s):
    """Write the files Hyprland and hypridle read."""
    os.makedirs(CFG + "/hypr", exist_ok=True)
    out = ["-- Generated by m3-settings - do not edit; use the Settings app (Super+I).",
           "-- Your own overrides belong in user.lua, which is loaded after this file.", ""]
    for name, m in sorted(s["monitors"].items()):
        out.append("hl.monitor({ output = %s, mode = %s, position = %s, scale = %s })"
                   % (lua_str(name), lua_str(m.get("mode", "preferred")),
                      lua_str(m.get("position", "auto")), m.get("scale", 1)))
    out += ["", "hl.config({",
            "    general = { gaps_in = %d, gaps_out = %d, border_size = %d },"
            % (max(0, int(s["gaps"]) // 2), int(s["gaps"]), int(s["border"])),
            "    decoration = { rounding = %d }," % int(s["rounding"]),
            "    animations = { enabled = %s }," % lua_bool(s["animations"]),
            "    input = {",
            "        kb_layout = %s," % lua_str(s["kb_layout"]),
            "        kb_variant = %s," % lua_str(s["kb_variant"]),
            "        sensitivity = %.2f," % float(s["mouse_sensitivity"]),
            "        accel_profile = %s," % lua_str("adaptive" if s["mouse_accel"] else "flat"),
            "        natural_scroll = %s," % lua_bool(s["mouse_natural"]),
            "        left_handed = %s," % lua_bool(s["left_handed"]),
            "        touchpad = { natural_scroll = %s, tap_to_click = %s },"
            % (lua_bool(s["touchpad_natural"]), lua_bool(s["tap_to_click"])),
            "    },", "})"]
    if s["night_light"]:
        out += ["", "hl.on(\"hyprland.start\", function()",
                "    hl.exec_cmd(\"hyprsunset -t %d\")" % int(s["night_temp"]), "end)"]
    with open(CFG + "/hypr/settings.lua", "w") as f:
        f.write("\n".join(out) + "\n")

    idle = ["# Generated by m3-settings - change these in Settings > Lock screen.",
            "general {",
            "    lock_cmd = pidof hyprlock || hyprlock",
            "    before_sleep_cmd = loginctl lock-session",
            "    after_sleep_cmd = hyprctl dispatch 'hl.dsp.dpms({ action = \"on\" })'",
            "}"]
    if int(s["lock_after"]) > 0:
        idle += ["listener {", "    timeout = %d" % int(s["lock_after"]),
                 "    on-timeout = loginctl lock-session", "}"]
    if int(s["screen_off_after"]) > 0:
        idle += ["listener {", "    timeout = %d" % int(s["screen_off_after"]),
                 "    on-timeout = hyprctl dispatch 'hl.dsp.dpms({ action = \"off\" })'",
                 "    on-resume = hyprctl dispatch 'hl.dsp.dpms({ action = \"on\" })'", "}"]
    with open(CFG + "/hypr/hypridle.conf", "w") as f:
        f.write("\n".join(idle) + "\n")


def in_session():
    return bool(os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"))


def reload_hyprland():
    if in_session():
        run("hyprctl", "reload")


def restart_hypridle():
    if in_session():
        subprocess.run(["pkill", "-x", "hypridle"])
        subprocess.Popen(["hypridle"], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def apply_waybar(s):
    """Regenerate ~/.config/waybar/config.jsonc and reload Waybar."""
    cfg_file = CFG + "/waybar/config.jsonc"
    fallback_file = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "config", "waybar", "config.jsonc")
    try:
        source_path = cfg_file if os.path.exists(cfg_file) else fallback_file
        with open(source_path, encoding="utf-8") as f:
            content = f.read()
        lines = [l for l in content.splitlines() if not l.strip().startswith("//")]
        data = json.loads("\n".join(lines))
    except Exception:
        return

    # Update clock format
    is_12h = s.get("bar_12h", True)
    show_date = s.get("bar_show_date", True)
    show_sec = s.get("bar_show_seconds", False)
    t_fmt = "%I:%M:%S %p" if show_sec else "%I:%M %p" if is_12h else ("%H:%M:%S" if show_sec else "%H:%M")
    if show_date:
        data.setdefault("clock", {})["format"] = "{:%%a %%e %%b   %s}" % t_fmt
    else:
        data.setdefault("clock", {})["format"] = "{:%s}" % t_fmt

    # Update launcher format
    l_icon = s.get("bar_launcher_icon", "")
    show_text = s.get("bar_launcher_text", True)
    if show_text:
        launcher_fmt = "<span font_family='Material Symbols Rounded' size='13pt' rise='-2pt'>%s</span>  Search" % l_icon
    else:
        launcher_fmt = "<span font_family='Material Symbols Rounded' size='13pt' rise='-2pt'>%s</span>" % l_icon
    data.setdefault("custom/launcher", {})["format"] = launcher_fmt

    # Update modules
    left = ["custom/launcher", "hyprland/workspaces"]
    if s.get("bar_show_taskbar", True):
        left.append("wlr/taskbar")
    if s.get("bar_show_minimize", False):
        left.append("custom/minimize-btn")
    if s.get("bar_show_minimized", True):
        left.append("custom/minimized")
    data["modules-left"] = left

    right = []
    if s.get("bar_show_tray", True):
        right.append("tray")
    if s.get("bar_show_screenshot", False):
        right.append("custom/screenshot")
    if s.get("bar_show_theme", False):
        right.append("custom/theme")
    if s.get("bar_show_network", True):
        right.append("network")
    if s.get("bar_show_audio", True):
        right.append("pulseaudio")
    if s.get("bar_show_battery", True):
        right.append("battery")
    if s.get("bar_show_notifications", True):
        right.append("custom/notifications")
    right.append("custom/power")
    data["modules-right"] = right

    if "wlr/taskbar" in data and "icon-theme" in data["wlr/taskbar"]:
        del data["wlr/taskbar"]["icon-theme"]

    os.makedirs(os.path.dirname(cfg_file), exist_ok=True)
    with open(cfg_file + ".tmp", "w", encoding="utf-8") as f:
        json.dump(data, f, indent=4, ensure_ascii=False)
    os.replace(cfg_file + ".tmp", cfg_file)

    if in_session():
        subprocess.run(["pkill", "-SIGUSR2", "waybar"])


def night_light(s, on):
    s["night_light"] = bool(on)
    save(s)
    generate(s)
    subprocess.run(["pkill", "-x", "hyprsunset"])
    if on and in_session() and have("hyprsunset"):
        subprocess.Popen(["hyprsunset", "-t", str(int(s["night_temp"]))], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def split_nmcli(line):
    """Split one line of `nmcli -t` output (':' separated, '\\:' escaped)."""
    return [p.replace("\\:", ":").replace("\\\\", "\\") for p in re.split(r"(?<!\\):", line)]


def cli():
    a = sys.argv[1:]
    if a and a[0] == "--apply":
        s = load()
        generate(s)
        apply_waybar(s)
        save(s)
        return True
    if a and a[0] == "--night-light":
        s = load()
        what = a[1] if len(a) > 1 else "toggle"
        if what == "status":
            print("true" if s["night_light"] else "false")
        else:
            night_light(s, {"on": True, "off": False}.get(what, not s["night_light"]))
        return True
    if a and a[0] in ("-h", "--help"):
        print(__doc__)
        return True
    return False


if cli():
    sys.exit(0)

# --------------------------------------------------------------------- GUI --
import gi  # noqa: E402

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, Gio, GLib, Gtk  # noqa: E402

SEEDS = [("Purple", "#6750A4"), ("Indigo", "#4355B9"), ("Blue", "#0061A4"), ("Teal", "#006A6A"),
         ("Green", "#386A20"), ("Yellow", "#695F00"), ("Orange", "#8B5000"), ("Red", "#B3261E"),
         ("Pink", "#984061")]
STYLES = ["tonal-spot", "expressive", "vibrant", "fidelity", "content", "neutral", "monochrome",
          "fruit-salad", "rainbow"]
TIMES = [(60, "1 minute"), (120, "2 minutes"), (300, "5 minutes"), (600, "10 minutes"),
         (900, "15 minutes"), (1800, "30 minutes"), (3600, "1 hour"), (0, "Never")]
SCALES = [1, 1.25, 1.5, 1.75, 2, 2.5, 3]
APP_KINDS = [
    ("Web browser", ["x-scheme-handler/http", "x-scheme-handler/https", "text/html"]),
    ("Files", ["inode/directory"]),
    ("Email", ["x-scheme-handler/mailto"]),
    ("Text editor", ["text/plain"]),
    ("Images", ["image/png", "image/jpeg", "image/webp", "image/gif"]),
    ("Video", ["video/mp4", "video/x-matroska", "video/webm"]),
    ("Music", ["audio/mpeg", "audio/flac", "audio/ogg"]),
    ("PDF documents", ["application/pdf"]),
]
PAGES = [("appearance", "Appearance", "applications-graphics-symbolic"),
         ("display", "Display", "video-display-symbolic"),
         ("bar", "Top bar", "user-desktop-symbolic"),
         ("network", "Network", "network-wireless-symbolic"),
         ("bluetooth", "Bluetooth", "bluetooth-active-symbolic"),
         ("sound", "Sound", "audio-volume-high-symbolic"),
         ("input", "Keyboard & mouse", "input-keyboard-symbolic"),
         ("lock", "Lock screen", "system-lock-screen-symbolic"),
         ("apps", "Default apps", "view-app-grid-symbolic"),
         ("about", "About", "help-about-symbolic")]

APP_CSS = """
.m3-sidebar { background: transparent; padding: 8px; }
.m3-sidebar row { border-radius: 999px; min-height: 52px; margin: 2px 0; padding: 0 8px; }
.m3-sidebar row:selected { background: @secondary_container; color: @on_secondary_container; }
.m3-sidebar row label { font-weight: 500; }
.swatch { min-width: 38px; min-height: 38px; border-radius: 999px; padding: 0; border: 3px solid transparent; }
.swatch.current { border-color: @on_surface; }
.m3-hero { border-radius: 28px; background: @primary_container; color: @on_primary_container; padding: 24px; }
.m3-hero .title-1 { color: @on_primary_container; }
"""


def async_run(cmd, done, timeout=40):
    """Run cmd in a thread, then call done(ok, output) on the main loop."""
    def work():
        ok, out = run(*cmd, timeout=timeout)
        GLib.idle_add(lambda: (done(ok, out), False)[1])
    threading.Thread(target=work, daemon=True).start()


def combo(title, labels, selected, on_change, subtitle=None, search=False):
    row = Adw.ComboRow(title=title, model=Gtk.StringList.new(labels))
    if subtitle:
        row.set_subtitle(subtitle)
    if search:
        row.set_enable_search(True)
        row.set_expression(Gtk.PropertyExpression.new(Gtk.StringObject, None, "string"))
    if 0 <= selected < len(labels):
        row.set_selected(selected)
    row.connect("notify::selected", lambda r, _p: on_change(r.get_selected()))
    return row


def switch(title, active, on_change, subtitle=None):
    row = Adw.SwitchRow(title=title, active=active)
    if subtitle:
        row.set_subtitle(subtitle)
    row.connect("notify::active", lambda r, _p: on_change(r.get_active()))
    return row


def slider(title, lo, hi, step, value, on_change, subtitle=None, digits=0):
    row = Adw.ActionRow(title=title)
    if subtitle:
        row.set_subtitle(subtitle)
    sc = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, lo, hi, step)
    sc.set_value(value)
    sc.set_digits(digits)
    sc.set_size_request(260, -1)
    sc.set_valign(Gtk.Align.CENTER)
    state = {"timer": 0}

    def changed(_s):
        if state["timer"]:
            GLib.source_remove(state["timer"])

        def fire():
            state["timer"] = 0
            on_change(sc.get_value())
            return False
        state["timer"] = GLib.timeout_add(180, fire)
    sc.connect("value-changed", changed)
    row.add_suffix(sc)
    row.scale = sc
    return row


def info_row(title, value):
    row = Adw.ActionRow(title=title, subtitle=value or "Unknown")
    row.add_css_class("property")
    row.set_subtitle_selectable(True)
    return row


def status(icon, title, text):
    return Adw.StatusPage(icon_name=icon, title=title, description=text, vexpand=True)


class Settings(Adw.Application):
    def __init__(self, page):
        super().__init__(application_id="io.github.m3hyprland.Settings",
                         flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.start_page = page
        self.s = load()
        self.theme_css = Gtk.CssProvider()
        self.win = None

    # -- plumbing ----------------------------------------------------------
    def commit(self, reload=True, idle=False):
        save(self.s)
        generate(self.s)
        if reload:
            reload_hyprland()
        if idle:
            restart_hypridle()

    def set_value(self, key, value, **kw):
        self.s[key] = value
        self.commit(**kw)

    def toast(self, text):
        self.toasts.add_toast(Adw.Toast(title=text, timeout=3))

    def load_theme_css(self):
        css = ""
        for p in (CFG + "/waybar/colors.css", CFG + "/gtk-4.0/m3-colors.css"):
            try:
                css += open(p).read() + "\n"
            except OSError:
                pass
        if "define-color secondary_container" not in css:  # theme not generated yet
            css += ("@define-color secondary_container alpha(@accent_bg_color, .25);"
                    "@define-color on_secondary_container @window_fg_color;"
                    "@define-color primary_container alpha(@accent_bg_color, .3);"
                    "@define-color on_primary_container @window_fg_color;"
                    "@define-color on_surface @window_fg_color;")
        self.theme_css.load_from_string(css + APP_CSS)

    def theme(self, *args, then=None):
        """Call m3-theme, then recolour this window too."""
        def done(ok, out):
            if not ok:
                self.toast("Theme change failed: " + out[-80:])
            self.load_theme_css()
            dark = self.theme_get("mode") != "light"
            Adw.StyleManager.get_default().set_color_scheme(
                Adw.ColorScheme.FORCE_DARK if dark else Adw.ColorScheme.FORCE_LIGHT)
            if then:
                then()
        async_run([BIN + "m3-theme", *args], done, timeout=60)

    def theme_get(self, key):
        return run(BIN + "m3-theme", "get", key)[1]

    # -- window ------------------------------------------------------------
    def do_activate(self):
        if self.win:
            self.win.present()
            return
        self.load_theme_css()
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), self.theme_css, Gtk.STYLE_PROVIDER_PRIORITY_USER + 1)

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
        self.built = {}
        self.listbox = Gtk.ListBox(selection_mode=Gtk.SelectionMode.SINGLE)
        self.listbox.add_css_class("m3-sidebar")
        for key, title, icon in PAGES:
            box = Gtk.Box(spacing=16, margin_start=10, margin_end=10)
            box.append(Gtk.Image.new_from_icon_name(icon))
            box.append(Gtk.Label(label=title, xalign=0))
            row = Gtk.ListBoxRow(child=box)
            row.key = key
            self.listbox.append(row)
        self.listbox.connect("row-selected", self.on_row)

        side = Adw.ToolbarView()
        side.add_top_bar(Adw.HeaderBar(title_widget=Adw.WindowTitle(title="Settings")))
        side.set_content(Gtk.ScrolledWindow(child=self.listbox, hscrollbar_policy=Gtk.PolicyType.NEVER))

        self.content_title = Adw.WindowTitle(title="")
        main = Adw.ToolbarView()
        main.add_top_bar(Adw.HeaderBar(title_widget=self.content_title))
        self.toasts = Adw.ToastOverlay(child=self.stack)
        main.set_content(self.toasts)

        split = Adw.NavigationSplitView(min_sidebar_width=250, max_sidebar_width=290)
        split.set_sidebar(Adw.NavigationPage(title="Settings", child=side))
        self.content_page = Adw.NavigationPage(title="Settings", child=main)
        split.set_content(self.content_page)
        self.split = split

        self.win = Adw.ApplicationWindow(application=self, title="Settings",
                                         default_width=1040, default_height=720, content=split)
        self.win.set_size_request(360, 300)
        bp = Adw.Breakpoint.new(Adw.BreakpointCondition.parse("max-width: 700sp"))
        bp.add_setter(split, "collapsed", True)
        self.win.add_breakpoint(bp)

        keys = [p[0] for p in PAGES]
        idx = keys.index(self.start_page) if self.start_page in keys else 0
        self.listbox.select_row(self.listbox.get_row_at_index(idx))
        self.win.present()

    def on_row(self, _lb, row):
        if not row:
            return
        key = row.key
        title = dict((p[0], p[1]) for p in PAGES)[key]
        if key not in self.built:
            page = getattr(self, "page_" + key)()
            self.stack.add_named(page, key)
            self.built[key] = page
        self.stack.set_visible_child_name(key)
        self.content_title.set_title(title)
        self.content_page.set_title(title)
        self.split.set_show_content(True)

    def rebuild(self, key):
        old = self.built.pop(key, None)
        if old:
            self.stack.remove(old)
        page = getattr(self, "page_" + key)()
        self.stack.add_named(page, key)
        self.built[key] = page
        self.stack.set_visible_child_name(key)

    @staticmethod
    def page(*groups):
        p = Adw.PreferencesPage()
        for g in groups:
            p.add(g)
        return p

    @staticmethod
    def group(title=None, description=None, rows=()):
        g = Adw.PreferencesGroup()
        if title:
            g.set_title(title)
        if description:
            g.set_description(description)
        for r in rows:
            g.add(r)
        return g

    # -- Appearance --------------------------------------------------------
    def page_appearance(self):
        mode, style = self.theme_get("mode"), self.theme_get("style")
        color, wall = self.theme_get("color").upper(), self.theme_get("wallpaper")
        from_wall = self.theme_get("source") == "wallpaper"

        dark = switch("Dark theme", mode != "light", lambda on: self.theme("dark" if on else "light"))

        flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, max_children_per_line=9,
                           min_children_per_line=5, column_spacing=6, row_spacing=6,
                           margin_top=12, margin_bottom=12, margin_start=12, margin_end=12)
        swatches = []
        for name, hexv in SEEDS:
            b = Gtk.Button(tooltip_text=name)
            b.add_css_class("swatch")
            css = Gtk.CssProvider()
            css.load_from_string("button { background: %s; }" % hexv)
            b.get_style_context().add_provider(css, Gtk.STYLE_PROVIDER_PRIORITY_USER + 2)
            if hexv.upper() == color and not from_wall:
                b.add_css_class("current")

            def pick(btn, h=hexv):
                for o in swatches:
                    o.remove_css_class("current")
                btn.add_css_class("current")
                self.theme("color", h)
            b.connect("clicked", pick)
            swatches.append(b)
            flow.append(b)
        flow_row = Adw.PreferencesRow(child=flow, activatable=False)

        custom = Adw.ActionRow(title="Custom colour", subtitle="Any colour becomes a full Material 3 palette")
        rgba = Gdk.RGBA()
        rgba.parse(color if color.startswith("#") else "#6750A4")
        cbtn = Gtk.ColorDialogButton(dialog=Gtk.ColorDialog(with_alpha=False), rgba=rgba,
                                     valign=Gtk.Align.CENTER)

        def custom_set(btn, _p):
            c = btn.get_rgba()
            for o in swatches:
                o.remove_css_class("current")
            self.theme("color", "#%02X%02X%02X" % (round(c.red * 255), round(c.green * 255), round(c.blue * 255)))
        cbtn.connect("notify::rgba", custom_set)
        custom.add_suffix(cbtn)

        style_row = combo("Palette style", [x.replace("-", " ").capitalize() for x in STYLES],
                          STYLES.index(style) if style in STYLES else 0,
                          lambda i: self.theme("style", STYLES[i]),
                          subtitle="How colourful the palette is")

        wrow = Adw.ActionRow(title="Wallpaper",
                             subtitle="Material 3 shapes" if wall == "shapes" else os.path.basename(wall))
        shapes = Gtk.Button(label="M3 shapes", valign=Gtk.Align.CENTER)
        shapes.connect("clicked", lambda _b: self.theme("wallpaper", "shapes",
                                                         then=lambda: self.rebuild("appearance")))
        choose = Gtk.Button(label="Choose image…", valign=Gtk.Align.CENTER)
        choose.add_css_class("suggested-action")

        def choose_file(_b):
            f = Gtk.FileFilter(name="Images")
            for pat in ("*.png", "*.jpg", "*.jpeg", "*.webp"):
                f.add_pattern(pat)
            filters = Gio.ListStore.new(Gtk.FileFilter)
            filters.append(f)
            dlg = Gtk.FileDialog(title="Choose a wallpaper", filters=filters)

            def opened(d, res):
                try:
                    path = d.open_finish(res).get_path()
                except GLib.Error:
                    return
                self.theme("wallpaper", path, then=lambda: self.rebuild("appearance"))
            dlg.open(self.win, None, opened)
        choose.connect("clicked", choose_file)
        wrow.add_suffix(shapes)
        wrow.add_suffix(choose)
        wall_note = "Colours are taken from the image." if from_wall else None

        packs = set()
        for base in ("/usr/share/icons", HOME + "/.local/share/icons", HOME + "/.icons"):
            try:
                for d in os.listdir(base):
                    try:
                        if "Directories=" in open(os.path.join(base, d, "index.theme"), errors="replace").read():
                            packs.add(d)
                    except OSError:
                        pass
            except OSError:
                pass
        packs = sorted(packs - {"hicolor", "default", "locolor", "gnome", "LoginIcons"}, key=str.lower)
        cur_icons = run("gsettings", "get", "org.gnome.desktop.interface", "icon-theme")[1].strip("'")
        icon_row = combo("Icon pack", packs, packs.index(cur_icons) if cur_icons in packs else -1,
                         lambda i: self.theme("icons", packs[i]), search=True,
                         subtitle="Icons for apps, folders and files")

        def spin(title, key, lo, hi, sub):
            r = Adw.SpinRow.new_with_range(lo, hi, 1)
            r.set_title(title)
            r.set_subtitle(sub)
            r.set_value(self.s[key])
            r.connect("notify::value", lambda rr, _p: self.set_value(key, int(rr.get_value())))
            return r

        return self.page(
            self.group("Theme", rows=[dark]),
            self.group("Colour", "Pick a seed colour. Open apps pick it up when reopened.",
                       rows=[flow_row, custom, style_row]),
            self.group("Icons", rows=[icon_row]),
            self.group("Wallpaper", wall_note, rows=[wrow]),
            self.group("Windows", rows=[
                spin("Corner radius", "rounding", 0, 36, "Material 3 uses 16 to 28"),
                spin("Gap between windows", "gaps", 0, 32, "Space around tiled windows"),
                spin("Border width", "border", 0, 6, "Outline of the focused window"),
                switch("Animations", self.s["animations"], lambda on: self.set_value("animations", on)),
            ]))

    # -- Display -----------------------------------------------------------
    def page_display(self):
        ok, out = run("hyprctl", "monitors", "-j")
        try:
            mons = json.loads(out) if ok else []
        except ValueError:
            mons = []
        groups = []
        if len(mons) > 1:
            arr = Adw.PreferencesGroup(title="Arrangement",
                                       description="Drag a screen to where it sits on your desk.")
            arr.add(Adw.PreferencesRow(child=self.arrange_widget(mons), activatable=False))
            groups.append(arr)
        for m in mons:
            name = m["name"]
            modes = m.get("availableModes") or []
            current = "%dx%d@%.2fHz" % (m["width"], m["height"], m["refreshRate"])
            labels = [x.replace("@", " at ").replace("Hz", " Hz") for x in modes]
            sel = modes.index(current) if current in modes else -1
            if sel < 0:  # match on resolution only
                sel = next((i for i, x in enumerate(modes)
                            if x.startswith("%dx%d@" % (m["width"], m["height"]))), 0)

            def set_mode(i, name=name, modes=modes):
                self.s["monitors"].setdefault(name, {})["mode"] = modes[i].replace("Hz", "")
                self.commit()

            def set_scale(i, name=name):
                self.s["monitors"].setdefault(name, {})["scale"] = SCALES[i]
                self.commit()
            scale = m.get("scale", 1)
            ssel = min(range(len(SCALES)), key=lambda i: abs(SCALES[i] - scale))
            rows = []
            if modes:
                rows.append(combo("Resolution", labels, sel, set_mode))
            rows.append(combo("Scale", ["%d%%" % round(x * 100) for x in SCALES], ssel, set_scale,
                              subtitle="Makes everything bigger on dense screens"))
            groups.append(self.group(name, m.get("description", ""), rows))
        if not groups:
            groups.append(self.group("Displays", "Display settings are available inside a Hyprland session."))

        temp = slider("Colour temperature", 2500, 6000, 100, self.s["night_temp"],
                      lambda v: (self.s.__setitem__("night_temp", int(v)),
                                 night_light(self.s, self.s["night_light"])),
                      subtitle="Lower is warmer")
        nl = switch("Night light", self.s["night_light"], lambda on: night_light(self.s, on),
                    subtitle="Warmer colours for the evening" if have("hyprsunset")
                    else "Needs the hyprsunset package")
        nl.set_sensitive(have("hyprsunset"))
        groups.append(self.group("Night light", rows=[nl, temp]))
        return self.page(*groups)

    def arrange_widget(self, mons):
        rects = {}
        for m in mons:
            w, h = m["width"] / m.get("scale", 1), m["height"] / m.get("scale", 1)
            if m.get("transform", 0) % 2:
                w, h = h, w
            rects[m["name"]] = [float(m["x"]), float(m["y"]), w, h]
        area = Gtk.DrawingArea(content_height=280, hexpand=True)
        st = {"drag": None, "start": None, "lay": None}

        def layout(w, h):
            x0 = min(r[0] for r in rects.values()); x1 = max(r[0] + r[2] for r in rects.values())
            y0 = min(r[1] for r in rects.values()); y1 = max(r[1] + r[3] for r in rects.values())
            sc = min((w - 80) / max(1, x1 - x0), (h - 60) / max(1, y1 - y0))
            return sc, (w - (x1 - x0) * sc) / 2 - x0 * sc, (h - (y1 - y0) * sc) / 2 - y0 * sc

        def colour(name, fallback):
            ok, c = area.get_style_context().lookup_color(name)
            if ok:
                return c
            c = Gdk.RGBA(); c.parse(fallback); return c

        def draw(_a, cr, w, h):
            sc, ox, oy = st["lay"] or layout(w, h)
            fill = colour("primary_container", "#4d3d75")
            text = colour("on_primary_container", "#e9ddff")
            line = colour("primary", "#cfbdfe")
            for name, r in sorted(rects.items(), key=lambda kv: kv[0] == st["drag"]):
                is_dragged = (name == st["drag"])
                x, y, ww, hh = r[0] * sc + ox + 2, r[1] * sc + oy + 2, r[2] * sc - 4, r[3] * sc - 4
                rad = 14
                cr.new_sub_path()
                cr.arc(x + ww - rad, y + rad, rad, -1.5708, 0)
                cr.arc(x + ww - rad, y + hh - rad, rad, 0, 1.5708)
                cr.arc(x + rad, y + hh - rad, rad, 1.5708, 3.1416)
                cr.arc(x + rad, y + rad, rad, 3.1416, 4.7124)
                cr.close_path()

                cr.set_source_rgba(fill.red, fill.green, fill.blue, 0.95 if is_dragged else 0.85)
                cr.fill_preserve()

                if is_dragged:
                    cr.set_source_rgba(line.red, line.green, line.blue, 1.0)
                    cr.set_line_width(3)
                else:
                    cr.set_source_rgba(line.red, line.green, line.blue, 0.45)
                    cr.set_line_width(1.5)
                cr.stroke()

                cr.set_source_rgba(text.red, text.green, text.blue, 1.0)
                cr.select_font_face("Google Sans", 0, 1)
                cr.set_font_size(14)
                ext = cr.text_extents(name)
                cr.move_to(x + (ww - ext.width) / 2, y + hh / 2 - 4)
                cr.show_text(name)

                m_info = next((m for m in mons if m["name"] == name), {})
                if m_info:
                    cr.select_font_face("Roboto", 0, 0)
                    cr.set_font_size(11)
                    sub = "%dx%d  %.0fHz" % (m_info["width"], m_info["height"], m_info.get("refreshRate", 60.0))
                    ext_sub = cr.text_extents(sub)
                    cr.move_to(x + (ww - ext_sub.width) / 2, y + hh / 2 + 14)
                    cr.show_text(sub)
        area.set_draw_func(draw)

        def begin(gesture, x, y):
            st["lay"] = layout(area.get_width(), area.get_height())
            sc, ox, oy = st["lay"]
            for name, r in rects.items():
                if r[0] * sc + ox <= x <= (r[0] + r[2]) * sc + ox and r[1] * sc + oy <= y <= (r[1] + r[3]) * sc + oy:
                    st["drag"], st["start"] = name, (r[0], r[1])
                    gesture.set_state(Gtk.EventSequenceState.CLAIMED)
                    area.set_cursor_from_name("grabbing")
                    area.queue_draw()
                    break

        def update(_g, dx, dy):
            if st["drag"]:
                sc = st["lay"][0]
                rects[st["drag"]][0] = st["start"][0] + dx / sc
                rects[st["drag"]][1] = st["start"][1] + dy / sc
                area.queue_draw()

        def end(_g, _dx, _dy):
            name, st["drag"], st["lay"] = st["drag"], None, None
            area.set_cursor_from_name("default")
            if not name:
                return
            r = rects[name]
            best = None
            for other, o in rects.items():
                if other == name:
                    continue
                def along(v, lo, size, osize):   # keep the screens touching, snap to aligned edges
                    v = min(max(v, lo - size + 120), lo + osize - 120)
                    for snap in (lo, lo + osize - size, lo + (osize - size) / 2):
                        if abs(v - snap) < 90:
                            return snap
                    return v
                cands = [(o[0] + o[2], along(r[1], o[1], r[3], o[3])), (o[0] - r[2], along(r[1], o[1], r[3], o[3])),
                         (along(r[0], o[0], r[2], o[2]), o[1] + o[3]), (along(r[0], o[0], r[2], o[2]), o[1] - r[3])]
                for cx, cy in cands:
                    d = (cx - r[0]) ** 2 + (cy - r[1]) ** 2
                    if best is None or d < best[0]:
                        best = (d, cx, cy)
            if best:
                r[0], r[1] = best[1], best[2]
            mx, my = min(q[0] for q in rects.values()), min(q[1] for q in rects.values())
            for n, q in rects.items():
                q[0], q[1] = round(q[0] - mx), round(q[1] - my)
                m_info = next((m for m in mons if m["name"] == n), {})
                cfg = self.s["monitors"].setdefault(n, {})
                cfg["position"] = "%dx%d" % (q[0], q[1])
                if "mode" not in cfg and "width" in m_info:
                    cfg["mode"] = "%dx%d@%.2f" % (m_info["width"], m_info["height"], m_info.get("refreshRate", 60.0))
                if "scale" not in cfg and "scale" in m_info:
                    cfg["scale"] = m_info.get("scale", 1)
            area.queue_draw()
            self.commit()

        g = Gtk.GestureDrag()
        g.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        g.connect("drag-begin", begin)
        g.connect("drag-update", update)
        g.connect("drag-end", end)
        area.add_controller(g)

        motion = Gtk.EventControllerMotion()
        def on_motion(_ctrl, x, y):
            if st["drag"]:
                return
            sc, ox, oy = layout(area.get_width(), area.get_height())
            hit = any(r[0] * sc + ox <= x <= (r[0] + r[2]) * sc + ox and r[1] * sc + oy <= y <= (r[1] + r[3]) * sc + oy for r in rects.values())
            area.set_cursor_from_name("grab" if hit else "default")
        motion.connect("motion", on_motion)
        area.add_controller(motion)

        return area

    # -- Top bar -----------------------------------------------------------
    def page_bar(self):
        def update_bar_setting(key, val):
            self.s[key] = val
            save(self.s)
            apply_waybar(self.s)

        # Clock
        r_12h = switch("12-hour time", self.s.get("bar_12h", True),
                       lambda on: update_bar_setting("bar_12h", on),
                       subtitle="Use 12-hour AM/PM format instead of 24-hour")
        r_date = switch("Show date", self.s.get("bar_show_date", True),
                        lambda on: update_bar_setting("bar_show_date", on),
                        subtitle="Display the day and month next to time")
        r_sec = switch("Show seconds", self.s.get("bar_show_seconds", False),
                       lambda on: update_bar_setting("bar_show_seconds", on),
                       subtitle="Include seconds in the clock display")

        # Launcher icon
        launcher_icons = [
            ("", "Search (default)"),
            ("", "Apps grid"),
            ("", "Sparkle"),
            ("", "Linux Tux"),
            ("", "Terminal"),
            ("", "Star"),
        ]
        cur_icon = self.s.get("bar_launcher_icon", "")
        icon_chars = [x[0] for x in launcher_icons]
        icon_labels = ["%s   %s" % (x[0], x[1]) for x in launcher_icons]
